# Discord Bot Token
DISCORD_TOKEN="YOUR_BOT_TOKEN_HERE"

# 可选：拥有消息内容特权的 Bot Token，用于原生转发处罚证据消息。
# 留空时使用当前 Bot；此配置与远端消息事件开关独立。
STELLARIA_FORWARD_BOT_TOKEN=""

# Database file name
DATABASE_NAME="data/database.db"

# Logging level (e.g., DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL="INFO"

# SQLAlchemy log level (e.g., DEBUG, INFO, WARNING, ERROR)
SQLALCHEMY_LOG_LEVEL="WARNING"

# Use the local Discord listener by default; production can enable remote events.
STELLARIA_REMOTE_MESSAGE_EVENTS_ENABLED="false"
STELLARIA_EVENT_API_BIND_HOST="0.0.0.0"
STELLARIA_EVENT_API_PORT="8765"
STELLARIA_EVENT_API_TOKEN=""
BOT_BRIDGE_NETWORK="Odysseia-BOT"
